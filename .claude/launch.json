{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "code-secours",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js", "--reset"],
      "port": 3000
    },
    {
      "name": "code-secours-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js", "--reset", "--tunnel"],
      "port": 3000
    },
    {
      "name": "code-secours-demo-3001",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js", "--reset", "--tunnel"],
      "env": { "PORT": "3001" },
      "port": 3001
    },
    {
      "name": "code-secours-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.js", "--dev", "--reset"],
      "port": 3000
    }
  ]
}
