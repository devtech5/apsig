# Copier en .env (jamais versionné)
DATABASE_URL="postgresql://apsig:apsig@localhost:55432/apsig"
TEST_DATABASE_URL="postgresql://apsig:apsig@localhost:55432/apsig_test"
REDIS_URL="redis://localhost:6380"
# URL encodée dans les QR codes
PUBLIC_ALERT_URL="http://localhost:3001"
# API (serveur Node)
API_PORT=4000
# Adresse de l'API vue par le navigateur du témoin (page d'alerte)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Adresse de l'API vue par le navigateur du témoin (page d'alerte)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Origines autorisées à appeler l'API depuis le navigateur (séparées par des virgules)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"
# 1 derrière le proxy d'un hébergeur
TRUST_PROXY=0
# Déclenchements d'alerte max par minute et par IP
RATE_LIMIT_ALERTES=6
