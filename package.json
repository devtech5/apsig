{
  "name": "apsig",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "db:generate": "pnpm --filter @apsig/db generate",
    "db:validate": "pnpm --filter @apsig/db validate",
    "db:migrate": "pnpm --filter @apsig/db migrate",
    "db:studio": "pnpm --filter @apsig/db studio"
  },
  "devDependencies": {
    "turbo": "^2.11.9"
  }
}
